# Copy this file to .env and fill in values for local development.
# .env is gitignored — never commit credentials.

# ── Data source ───────────────────────────────────────────────────────────────
# "local" reads from LOCAL_DATA_PATH; "s3" reads from S3_BUCKET/S3_KEY
DATA_SOURCE=local

# Absolute path to the Excel workbook (only used when DATA_SOURCE=local)
# Defaults to ../Team6Dataset_Enhanced.xlsx relative to this file.
# LOCAL_DATA_PATH=/absolute/path/to/Team6Dataset_Enhanced.xlsx

# ── S3 (only when DATA_SOURCE=s3) ────────────────────────────────────────────
S3_BUCKET=your-hackathon-bucket
S3_KEY=data/Team6Dataset_Enhanced.xlsx

# ── AWS credentials (only needed when DATA_SOURCE=s3) ────────────────────────
# For local development with S3, set these or use an AWS profile.
# On Lambda, use the execution role instead — do NOT hard-code here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# ── Flask ─────────────────────────────────────────────────────────────────────
PORT=8000
FLASK_DEBUG=true
CORS_ORIGIN=http://localhost:5173

# ── Amazon Bedrock (Phase 4) ──────────────────────────────────────────────────
# Region where Bedrock is enabled in your account
BEDROCK_REGION=us-east-1

# Model ID — must be enabled in your account's Bedrock Model Access page
# Options:
#   amazon.titan-text-premier-v1:0           (default, widely available)
#   anthropic.claude-3-haiku-20240307-v1:0   (fast, cheap)
#   anthropic.claude-3-sonnet-20240229-v1:0  (higher quality)
#   amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=amazon.titan-text-premier-v1:0

# Max tokens for Bedrock responses (default 1024)
BEDROCK_MAX_TOKENS=1024

# Temperature — lower = more deterministic/factual (0.0-1.0)
BEDROCK_TEMPERATURE=0.2

# For local dev with Bedrock, set AWS credentials or use a named profile.
# On Lambda, the execution role handles auth — do NOT set keys here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=default
