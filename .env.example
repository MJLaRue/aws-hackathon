PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=mysql://budget:budget_local_only@127.0.0.1:3307/uic_budget
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
MOCK_AUTH=true
DEMO_DATA=true
# Production: MOCK_AUTH=false, HTTPS APP_ORIGIN, a unique SESSION_SECRET.
# Use a secrets manager for production credentials; never commit .env.
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CALLBACK_URL=
SAML_IDP_CERT=
SAML_SP_PRIVATE_KEY=
SAML_SP_CERT=
SAML_NETID_ATTRIBUTE=uid

# Python workbook analytics service (loopback only)
ANALYTICS_PORT=8001
ANALYTICS_URL=http://127.0.0.1:8001
