# Required for live mode. Use an inference profile id your account can call (tool use required), e.g. from:
#   aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (SSO, assumed role):
AWS_SESSION_TOKEN=
# Alternative to the three keys above: a Bedrock API key from the Bedrock console
AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_REGION=us-east-1
REPLAY_MODE=false
BEDROCK_TIMEOUT_SECONDS=30
ANOMALY_SENSITIVITY=2.5
FORECAST_HORIZON=4
FORECAST_MAE_HIGH=0.05
FORECAST_MAE_LOW=0.15
FORECAST_SMAPE_HIGH=10.0
FORECAST_SMAPE_LOW=30.0
FORECAST_PI_WIDTH_MEDIUM=0.3
KPI_TOP_N=5
ANOMALY_ABS_FLOOR=30.0
