{
  "name": "aws-uic-budget-forecasting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "db:migrate": "node server/cli.js migrate",
    "db:seed": "node server/cli.js seed",
    "db:setup": "node server/cli.js setup",
    "db:rollover": "node server/cli.js rollover",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@node-saml/node-saml": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sequelize": "^6.37.7",
    "zod": "^4.1.11"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "vite": "^7.1.9"
  }
}
